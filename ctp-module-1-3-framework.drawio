<diagram name="2 · Module 2 Design" id="m2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1183" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="m2_k72" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1450" height="1033" as="geometry"/></mxCell>
<mxCell id="m2_t1" value="&lt;b&gt;Module 2 · DESIGN – Sơ đồ hệ thống (Chapter 1-9)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1300" height="34" as="geometry"/></mxCell>
<mxCell id="m2_b2" value="M1 · Analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m2_b3" value="&lt;b&gt;M2 · Design&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m2_b4" value="M3 · Development" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m2_b5" value="M4 · Implementation&lt;br&gt;&lt;i&gt;(sắp học)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m2_b6" value="M5 · Evaluation&lt;br&gt;&lt;i&gt;(sắp học)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="840" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m2_e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b2" target="m2_b3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b3" target="m2_b4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b4" target="m2_b5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b5" target="m2_b6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_t11" value="&lt;b&gt;INPUT &amp;amp; VAI TRÒ ID&lt;br&gt;[Ch2, Ch4]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="36" as="geometry"/></mxCell>
<mxCell id="m2_b12" value="&lt;b&gt;Khi nào cần learning solution?&lt;/b&gt; Người mới · làm kém do thiếu skill · chuyển việc (reskilling) · việc đổi do công nghệ mới · việc phức tạp hơn (upskilling) · process/system mới · quy định mới" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="174" width="300" height="93" as="geometry"/></mxCell>
<mxCell id="m2_b13" value="&lt;b&gt;2 ý phải nhớ&lt;/b&gt;: EMPATHIZE + INVESTIGATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="295" width="300" height="33" as="geometry"/></mxCell>
<mxCell id="m2_b14" value="&lt;b&gt;ID&lt;/b&gt; = tạo trải nghiệm &amp;amp; tài liệu học giúp người học &lt;b&gt;tiếp thu và áp dụng&lt;/b&gt; kiến thức, kỹ năng (ATD 2017). Nằm ở 2 chữ D: Design (Theoretical tools) + Develop (Physical tools) [Ch1-2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="300" height="93" as="geometry"/></mxCell>
<mxCell id="m2_b15" value="ID làm cùng &lt;b&gt;SME&lt;/b&gt; để xác định cần học gì. Người chỉ dựng storyboard trên Storyline/Captivate = e-learning developer, KHÔNG phải ID. Constructivist (Sims): người học tự xây kiến thức; 7 metrics tương tác [Ch2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="477" width="300" height="93" as="geometry"/></mxCell>
<mxCell id="m2_b16" value='&lt;b&gt;"Begin with the END in mind"&lt;/b&gt;: học viên phải thể hiện PERFORMANCE gì khi quay lại làm việc? [Ch4]' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="598" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m2_b17" value="&lt;b&gt;FEA&lt;/b&gt; = Performance gaps + Task analysis + Learner analysis → viết đúng objectives. Phân rã Job → Duties → Steps bằng &lt;b&gt;DACUM chart&lt;/b&gt; (nhóm SME, mỗi task bắt đầu bằng động từ) [Ch4]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="689" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m2_b18" value="Đánh giá theo task → &lt;b&gt;baseline skill level&lt;/b&gt; (Present vs Desired skill level) → trọng tâm thật sự của hoạt động học [Ch4]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="795" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m2_e19" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b12" target="m2_b13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e20" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b13" target="m2_b14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e21" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b14" target="m2_b15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e22" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b15" target="m2_b16"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e23" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b16" target="m2_b17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e24" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b17" target="m2_b18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_t25" value="&lt;b&gt;OBJECTIVES &amp;amp; ASSESSMENT&lt;br&gt;[Ch1, Ch3, Ch5]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="130" width="300" height="36" as="geometry"/></mxCell>
<mxCell id="m2_b26" value="&lt;b&gt;Design Process Model&lt;/b&gt;: chuẩn nhất = &lt;b&gt;Dick &amp;amp; Carey&lt;/b&gt; (chặt chẽ) ⊃ &lt;b&gt;MARIO&lt;/b&gt; (đơn giản, bước 1-4 = Design) [Ch3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="174" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m2_b27" value="&lt;b&gt;MARIO&lt;/b&gt;: Make objectives → Align assessment → Right format → Organize instruction strategy (bước 1-4 = Design) → Material (bước 5, sang Development) [Ch1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="265" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m2_b28" value="&lt;b&gt;Goal&lt;/b&gt; (muốn learner làm gì trên job) → &lt;b&gt;Terminal Objective&lt;/b&gt; (cụ thể, đánh giá được cuối khóa) → &lt;b&gt;Enabling Objectives&lt;/b&gt; (mục tiêu nhỏ hỗ trợ) [Ch1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="371" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m2_b29" value='&lt;b&gt;P-C-S&lt;/b&gt;: "[C] Using the PC in the computer lab, the learner will be able to [P] complete [S] one Skype chat and one video conference"' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="477" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m2_b30" value="&lt;b&gt;KSA → CPA&lt;/b&gt; + động từ: Knowledge→Cognitive (recall, compare, describe) · Skills→Psychomotor (perform, use, operate) · Attitudes→Affective (feel, model, aspire)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="568" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m2_b31" value="&lt;b&gt;Order of objectives&lt;/b&gt; (LWBAT): List = Knowledge (lặp lại, ghi nhớ) → Explain = Comprehension → Use = Application (thực hành). &lt;b&gt;Khác objective = khác khóa học&lt;/b&gt; [Ch5]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="674" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m2_b32" value="&lt;b&gt;Writing Objectives&lt;/b&gt;: learner-centered, performance-based; có nhiều category &amp;amp; hierarchy (video M6-L2 Domains &amp;amp; Hierarchy) [Ch5]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="780" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m2_b33" value="&lt;b&gt;Align Assessment&lt;/b&gt;: giống tiêu chí &amp;amp; điều kiện thực tế; loại CPA quyết định loại đánh giá; xét P-C-S. Test theo độ phức tạp: Fill-in/List → MCQ → Case/Problem solving → Essay → Dissertation → Research/Peer review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="886" width="300" height="93" as="geometry"/></mxCell>
<mxCell id="m2_b34" value="&lt;b&gt;Formative&lt;/b&gt; = pilot test trước khi phát hành · &lt;b&gt;Summative&lt;/b&gt; = xác nhận đạt objectives &amp;amp; tác động lên performance&lt;br&gt;&lt;b&gt;LAW OF ALIGNMENT&lt;/b&gt;: content – methods – activities – materials – assessments khớp objectives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="1007" width="300" height="108" as="geometry"/></mxCell>
<mxCell id="m2_e35" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b26" target="m2_b27"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e36" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b27" target="m2_b28"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e37" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b28" target="m2_b29"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e38" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b29" target="m2_b30"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e39" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b30" target="m2_b31"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e40" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b31" target="m2_b32"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e41" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b32" target="m2_b33"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e42" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b33" target="m2_b34"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_t43" value='&lt;b&gt;STRATEGY: "HOW" của việc học&lt;br&gt;[Ch1, Ch6]&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="130" width="300" height="36" as="geometry"/></mxCell>
<mxCell id="m2_b44" value="&lt;b&gt;Right Format&lt;/b&gt;: Face-to-face · Blended · E-learning · Mobile · Simulation · Supervised field · Distance. Sync hay async? On-the-job?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="174" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m2_b45" value="&lt;b&gt;Instructional Strategy&lt;/b&gt; = cách giúp learner đạt objectives &amp;amp; qua assessment: chọn format → content, sequencing, schedule, lessons/topics, materials [Ch6]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="265" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m2_b46" value="&lt;b&gt;Strategy Work Flow&lt;/b&gt;: Review objectives &amp;amp; assessment → Review design specs → Mind mapping → Design matrix → Develop material → Stakeholder feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="371" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m2_b47" value="&lt;b&gt;Design Specs&lt;/b&gt;: Stakeholder expectations · Learner profile · Assessment criteria · Goals &amp;amp; objectives · Time &amp;amp; Money. Kỹ thuật: Clothesline, Sticky notes, Mind maps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="477" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m2_b48" value="&lt;b&gt;Andragogy&lt;/b&gt;: người lớn cần biết VÌ SAO · tự định hướng · dùng kinh nghiệm cũ · sẵn sàng khi thấy cần · muốn áp dụng ngay · động lực trong &amp;amp; ngoài" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="583" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m2_b49" value="&lt;b&gt;VARK&lt;/b&gt; (Fleming &amp;amp; Mills 1992) · &lt;b&gt;Retention Pyramid&lt;/b&gt;: nghe → quên; nghe+thấy → nhớ chút; +hỏi/thảo luận → hiểu; +làm → có skill; dạy lại → master" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="689" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m2_b50" value="&lt;b&gt;Xu hướng&lt;/b&gt;: Learning in the Flow of Work, Micro-learning, LMS vô hình, &lt;b&gt;Learn in Public&lt;/b&gt; (chia sẻ việc học qua blog/YouTube)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="795" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m2_e51" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b44" target="m2_b45"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e52" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b45" target="m2_b46"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e53" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b46" target="m2_b47"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e54" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b47" target="m2_b48"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e55" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b48" target="m2_b49"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e56" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b49" target="m2_b50"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_t57" value="&lt;b&gt;OUTPUT: Blueprint&lt;br&gt;[Ch1, Ch7-9]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="130" width="300" height="36" as="geometry"/></mxCell>
<mxCell id="m2_b58" value="&lt;b&gt;Design Matrix&lt;/b&gt; 5 cột: TIME – TOPIC – METHOD – RESOURCE – ASSESSMENT (vd khóa Health &amp;amp; Safety: 9:00 Presentation → 10:30 Case study → 1:30 Plant inspection → 3:30 Proposals) [Ch1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="174" width="300" height="93" as="geometry"/></mxCell>
<mxCell id="m2_b59" value="&lt;b&gt;Design Blueprint&lt;/b&gt; = như bản vẽ kiến trúc: chỉ dẫn chi tiết, chính xác cho từng lesson, từng module. Tránh mô tả hời hợt [Ch7]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="295" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m2_b60" value="&lt;b&gt;Phép thử Blueprint&lt;/b&gt;: nếu NGƯỜI KHÁC làm Development, họ có làm được chỉ từ tài liệu này không?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="386" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m2_b61" value="&lt;b&gt;Learning Designer Tool&lt;/b&gt;: đi qua mọi điểm quyết định (thời gian, objective, hoạt động, F2F/online, cá nhân/nhóm) = làm thay Design Matrix [Ch9]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="477" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m2_b62" value='&lt;b&gt;AI trong Design&lt;/b&gt; [Ch8]: dùng như công cụ hỗ trợ — giảng viên cũng đang học ("not an expert on AI")' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="583" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m2_b63" value="→ Blueprint là đầu vào của &lt;b&gt;M3 Development&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="674" width="300" height="33" as="geometry"/></mxCell>
<mxCell id="m2_e64" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b58" target="m2_b59"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxCell id="m3_k66" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1450" height="821" as="geometry"/></mxCell>
<mxCell id="m3_t1" value="&lt;b&gt;Module 3 · DEVELOPMENT – Sơ đồ hệ thống&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1300" height="34" as="geometry"/></mxCell>
<mxCell id="m3_b2" value="M1 · Analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m3_b3" value="M2 · Design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m3_b4" value="&lt;b&gt;M3 · Development&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m3_b5" value="M4 · Implementation&lt;br&gt;&lt;i&gt;(sắp học)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m3_b6" value="M5 · Evaluation&lt;br&gt;&lt;i&gt;(sắp học)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="840" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m3_e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b2" target="m3_b3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b3" target="m3_b4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b4" target="m3_b5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b5" target="m3_b6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_t11" value="&lt;b&gt;KHỞI ĐỘNG DEVELOPMENT&lt;br&gt;[Overview of Development]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="36" as="geometry"/></mxCell>
<mxCell id="m3_b12" value='&lt;b&gt;Development = "hammer and nails"&lt;/b&gt;: Design là kiến trúc, Development là xây khóa học từng lesson theo specs của Design; dùng công cụ vật lý (LMS, phần mềm)' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="174" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b13" value="&lt;b&gt;Creative process&lt;/b&gt;: làm learner &lt;b&gt;WANT TO&lt;/b&gt; learn. Hỏi: &lt;i&gt;&quot;What's the coolest way to learn this?&quot;&lt;/i&gt; Chuẩn bị cho nhiều vòng review, xin feedback stakeholders thường xuyên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b14" value="&lt;b&gt;5 năng lực Developer&lt;/b&gt;: Subject expertise (bonus) · Computer literacy · Visual thinking · Authoring skills (viết) · E-learning authoring software (storyboard, animation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="386" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b15" value="&lt;b&gt;8 bước&lt;/b&gt;: Draft materials → Draft tests → Quality assurance → Reviewer feedback → Revise → Reviewer sign-off → Full production → Maintenance (BLT Section 3, tr.123)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="492" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b16" value="&lt;b&gt;Course Structure (modular chunks)&lt;/b&gt;: Lesson (đơn vị nhỏ nhất) → Module (các lesson liên quan) → Course. Scale bằng cách thêm lesson/module" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="598" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b17" value="&lt;b&gt;Visualizing the Course&lt;/b&gt;: nhìn big picture từ Design Matrix; sắp đúng thứ tự module &amp;amp; lesson bằng sketch, mind map, sticky notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="704" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m3_b18" value="&lt;b&gt;Bắt đầu từ đâu?&lt;/b&gt; Lesson 1 → &lt;b&gt;Lesson Plan&lt;/b&gt; (Facilitator Guide); khóa online learner-led → &lt;b&gt;Study Guide&lt;/b&gt;. ⚠ Bắt đầu bằng PowerPoint → mặc định thành lecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="795" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_e19" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b12" target="m3_b13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e20" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b13" target="m3_b14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e21" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b14" target="m3_b15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e22" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b15" target="m3_b16"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e23" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b16" target="m3_b17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e24" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b17" target="m3_b18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_t25" value="&lt;b&gt;LÝ THUYẾT DỰNG LESSON&lt;br&gt;[Theories Related to Development]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="130" width="300" height="36" as="geometry"/></mxCell>
<mxCell id="m3_b26" value="&lt;b&gt;Process theories&lt;/b&gt; = thế nào là dạy tốt. ⚠ Chia sẻ hết kiến thức mình biết &lt;b&gt;KHÔNG&lt;/b&gt; tạo ra learning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="174" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m3_b27" value='&lt;b&gt;Lesson có "shape"&lt;/b&gt;: beginning – middle – end' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="265" width="300" height="33" as="geometry"/></mxCell>
<mxCell id="m3_b28" value="&lt;b&gt;Gagne – Nine Events of Instruction&lt;/b&gt;: 9 bước, luôn theo đúng thứ tự.&lt;br&gt;&lt;i&gt;(Tên 9 bước theo Gagne gốc:)&lt;/i&gt; Gain attention → Inform objectives → Stimulate recall → Present content → Provide guidance → Elicit performance → Provide feedback → Assess performance → Enhance retention &amp;amp; transfer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="326" width="300" height="123" as="geometry"/></mxCell>
<mxCell id="m3_b29" value="&lt;b&gt;Merrill – First Principles of Instruction&lt;/b&gt;&lt;br&gt;&lt;i&gt;(theo Merrill gốc:)&lt;/i&gt; Problem-centered → Activation → Demonstration → Application → Integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="477" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b30" value="&lt;b&gt;Theory lesson (T) → OPPEA&lt;/b&gt;: Orient – Present – Practice – Evaluate – Apply (vd: Core Values)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="583" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m3_b31" value="&lt;b&gt;Skill lesson (S) → PESOS&lt;/b&gt;: Prepare – Explain – Show – Observe – Supervise (vd: Conducting an interview)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="674" width="300" height="63" as="geometry"/></mxCell>
<mxCell id="m3_b32" value='&lt;b&gt;Microlearning&lt;/b&gt;: làm micro-lesson "context-ready"' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="765" width="300" height="48" as="geometry"/></mxCell>
<mxCell id="m3_e33" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b26" target="m3_b27"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e34" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b27" target="m3_b28"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e35" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b28" target="m3_b29"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e36" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b29" target="m3_b30"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e37" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b30" target="m3_b31"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e38" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b31" target="m3_b32"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_t39" value="&lt;b&gt;METHODS &amp;amp; MEDIA&lt;br&gt;[Instructional Methods and Media]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="130" width="300" height="36" as="geometry"/></mxCell>
<mxCell id="m3_b40" value="Method &lt;b&gt;định hướng ở Design&lt;/b&gt;, &lt;b&gt;chọn cụ thể ở Development&lt;/b&gt; — dựa trên learning context, objectives, learning styles → quyết định courseware &amp;amp; media" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="174" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b41" value="Training ≠ presentation. Là về &lt;b&gt;learning&lt;/b&gt;: đưa learner từ Point A → Point B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="280" width="300" height="48" as="geometry"/></mxCell>
<mxCell id="m3_b42" value="&lt;b&gt;Chọn method&lt;/b&gt;: ① Check objective: low/knowledge → passive được; skill hoặc high-level (analysis, application) → active. ② Check learners: V-A-R → visual/audio/reading; T-K → hands-on, tương tác" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="356" width="300" height="93" as="geometry"/></mxCell>
<mxCell id="m3_b43" value="&lt;b&gt;Bloom&lt;/b&gt;: method passive (lecture) → kẹt ở Knowledge, khó nhớ; active (discussion, application thực tế) → retention tăng. Mantra: &lt;b&gt;LEARNER ENGAGEMENT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="477" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b44" value="&lt;b&gt;PowerPoint&lt;/b&gt;: tránh text-heavy &amp;amp; animation quá đà. Slide sạch (white space), font dễ đọc, Title 40-44 pt / Text 20-24 pt, bullet là cụm từ, template chuẩn, ảnh, video ngắn. Thêm thông tin → Notes làm handout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="583" width="300" height="93" as="geometry"/></mxCell>
<mxCell id="m3_b45" value="&lt;b&gt;Tools&lt;/b&gt;: Genially (quiz, game, contest, lesson – miễn phí), PowerPoint quiz template" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="704" width="300" height="48" as="geometry"/></mxCell>
<mxCell id="m3_e46" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b40" target="m3_b41"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e47" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b41" target="m3_b42"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e48" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b42" target="m3_b43"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e49" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b43" target="m3_b44"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e50" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b44" target="m3_b45"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_t51" value="&lt;b&gt;COURSE MATERIALS (Output)&lt;br&gt;[PG tr.15-21 · Using AI]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="130" width="300" height="36" as="geometry"/></mxCell>
<mxCell id="m3_b52" value="&lt;b&gt;Facilitator Guide&lt;/b&gt; gồm: Lesson title &amp;amp; goal · Time · Materials · Intro (what &amp;amp; why) · Presentation notes &amp;amp; slides · Learner activities · Quiz/test · Summary &amp;amp; transition. Bám OPPEA/PESOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="174" width="300" height="93" as="geometry"/></mxCell>
<mxCell id="m3_b53" value="&lt;b&gt;Lợi ích FG&lt;/b&gt;: checklist chuẩn bị · tập dượt · dạy nhất quán · nhiều facilitator dạy như nhau · không phụ thuộc slide · biết nói/làm gì lúc nào · dễ update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="295" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b54" value="&lt;b&gt;Participant Guide&lt;/b&gt; ≠ bản in slide: là &lt;b&gt;công cụ engage chính&lt;/b&gt; (notes, activities, exercises, quiz, case, role play, game). Phải &lt;b&gt;sync&lt;/b&gt; với FG &amp;amp; Slides" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="401" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b55" value="&lt;b&gt;Video từ PowerPoint&lt;/b&gt;: chọn slide → viết script → record narration &amp;amp; animation → Save MP4 → email/YouTube/Drive. Cách dễ nhất vào e-learning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="507" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b56" value="&lt;b&gt;Rapid E-learning&lt;/b&gt;: từ PowerPoint → nội dung &lt;b&gt;SCORM&lt;/b&gt; → LMS/website; &lt;b&gt;asynchronous&lt;/b&gt;; thêm narration, audio, animation, quiz, feedback real-time, interaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="613" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b57" value='&lt;b&gt;AI tools&lt;/b&gt;: ChatGPT/Copilot (course outline, facilitator guide), Gamma/Presentations.ai (slides), Copilot trong Office 365. Prompt tốt nhất có thể. &lt;b&gt;"You control your AI"&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="719" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_b58" value="&lt;b&gt;Bài tập M3&lt;/b&gt; (hạn 12/11): DV01+02 Instructional Theory &amp;amp; Course Lesson Plan · DV03 Develop Course Materials · DV04 Adopt Technology Solutions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="825" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="m3_e59" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b52" target="m3_b53"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e60" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b53" target="m3_b54"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e61" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b54" target="m3_b55"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e62" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b55" target="m3_b56"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e63" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b56" target="m3_b57"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e64" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m3_b57" target="m3_b58"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m3_e65" value="→ PG" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m3_b43" target="m3_b54"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>

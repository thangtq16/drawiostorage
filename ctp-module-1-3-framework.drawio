<diagram name="0 · Tổng quan M1-M3" id="ov"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="ov_t1" value="&lt;b&gt;e-CTP · Bức tranh tổng: Module 1 → 2 → 3 trên trục ADDIE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1100" height="34" as="geometry"/></mxCell>
<mxCell id="ov_b2" value="&lt;b&gt;M1 · Analysis&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="ov_b3" value="&lt;b&gt;M2 · Design&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="460" y="50" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="ov_b4" value="&lt;b&gt;M3 · Development&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="880" y="50" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="ov_b5" value="M4 · Implementation&lt;br&gt;&lt;i&gt;(13/11)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1300" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="ov_b6" value="M5 · Evaluation&lt;br&gt;&lt;i&gt;(20/11)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1500" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="ov_e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="ov_b2" target="ov_b3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ov_e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="ov_b3" target="ov_b4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ov_e9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="ov_b4" target="ov_b5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ov_e10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="ov_b5" target="ov_b6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ov_t11" value="&lt;i&gt;ADDIE = gold standard &amp;gt;50 năm (training cycle). Xu hướng hiện tại: đặt Evaluation ở TRUNG TÂM, 4 cấp: Reaction – Learning – Behavior – Impact [M1]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="1000" height="22" as="geometry"/></mxCell>
<mxCell id="ov_b12" value="&lt;b&gt;M1 · Câu hỏi cốt lõi&lt;/b&gt;&lt;br&gt;Có gap không? Vì sao có gap? Training có phải lời giải không?&lt;br&gt;&lt;br&gt;&lt;b&gt;Khung nhớ:&lt;/b&gt; WHAT → WHY → HOW&lt;br&gt;(Investigation → Root Cause → Intervention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="360" height="120" as="geometry"/></mxCell>
<mxCell id="ov_b13" value="&lt;b&gt;OUTPUT M1:&lt;/b&gt; Needs Analysis Report&lt;br&gt;gap đã định lượng + root cause (P hay E) + intervention đã chọn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="ov_b14" value="&lt;b&gt;Model phải nhớ (M1)&lt;/b&gt;&lt;br&gt;• B = f(P,E) – Kurt Lewin&lt;br&gt;• Gilbert 6 Boxes (BEM)&lt;br&gt;• Mager &amp;amp; Pipe: Can't do / Don't want to&lt;br&gt;• Rummler Organization Systems Model&lt;br&gt;• Table Research → Interview → Survey → Observation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="360" height="115" as="geometry"/></mxCell>
<mxCell id="ov_e15" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="ov_b2" target="ov_b12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ov_e16" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="ov_b12" target="ov_b13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ov_b17" value="&lt;b&gt;M2 · Câu hỏi cốt lõi&lt;/b&gt;&lt;br&gt;Học viên phải LÀM được gì? Đánh giá thế nào? Dạy bằng cách nào?&lt;br&gt;&lt;br&gt;&lt;b&gt;Khung nhớ:&lt;/b&gt; MARIO&lt;br&gt;(Make objectives → Align assessment → Right format → Organize instruction strategy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="460" y="150" width="360" height="120" as="geometry"/></mxCell>
<mxCell id="ov_b18" value="&lt;b&gt;OUTPUT M2:&lt;/b&gt; Objectives (P-C-S) + Assessment + Design Matrix = BLUEPRINT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="ov_b19" value="&lt;b&gt;Model phải nhớ (M2)&lt;/b&gt;&lt;br&gt;• Dick &amp;amp; Carey ⊃ MARIO&lt;br&gt;• Goal → Terminal → Enabling&lt;br&gt;• P-C-S, KSA → CPA&lt;br&gt;• Design Matrix 5 cột&lt;br&gt;• Andragogy, VARK, Retention Pyramid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="460" y="400" width="360" height="115" as="geometry"/></mxCell>
<mxCell id="ov_e20" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="ov_b3" target="ov_b17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ov_e21" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="ov_b17" target="ov_b18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ov_b22" value="&lt;b&gt;M3 · Câu hỏi cốt lõi&lt;/b&gt;&lt;br&gt;Xây từng lesson thế nào để learner WANT TO learn?&lt;br&gt;&lt;br&gt;&lt;b&gt;Khung nhớ:&lt;/b&gt; Draft → QA → Feedback → Revise → Sign-off → Production → Maintenance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="360" height="120" as="geometry"/></mxCell>
<mxCell id="ov_b23" value="&lt;b&gt;OUTPUT M3:&lt;/b&gt; Lesson Plan / Facilitator Guide, Participant Guide, slides, video, e-learning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="ov_b24" value="&lt;b&gt;Model phải nhớ (M3)&lt;/b&gt;&lt;br&gt;• Gagne 9 Events of Instruction&lt;br&gt;• Merrill First Principles&lt;br&gt;• OPPEA (theory lesson) / PESOS (skill lesson)&lt;br&gt;• Lesson → Module → Course&lt;br&gt;• FG – PG – Slides phải sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="400" width="360" height="115" as="geometry"/></mxCell>
<mxCell id="ov_e25" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="ov_b4" target="ov_b22"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ov_e26" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="ov_b22" target="ov_b23"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ov_e27" value="input" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;dashed=1;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="ov_b13" target="ov_b18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ov_e28" value="specs" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;dashed=1;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="ov_b18" target="ov_b23"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ov_b29" value='&lt;b&gt;4 SỢI CHỈ XUYÊN SUỐT (nhớ 4 câu này là nhớ cả 3 module)&lt;/b&gt;&lt;br&gt;① &lt;b&gt;Performance Orientation&lt;/b&gt; [M1]: đào tạo vì năng lực tổ chức cần, không vì có tài liệu hay → "Training is not always the answer"&lt;br&gt;② &lt;b&gt;Begin with the END in mind&lt;/b&gt; [M2]: bắt đầu từ performance học viên phải thể hiện khi quay lại làm việc&lt;br&gt;③ &lt;b&gt;Law of Alignment&lt;/b&gt; [M2]: objectives – nội dung – phương pháp – hoạt động – tài liệu – đánh giá phải khớp nhau&lt;br&gt;④ &lt;b&gt;Learner Engagement&lt;/b&gt; [M3]: chia sẻ hết kiến thức ≠ learning; method càng active, retention càng cao' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="1630" height="110" as="geometry"/></mxCell>
<mxCell id="ov_t30" value="&lt;i&gt;Mỗi trang sau (tab dưới cùng) là chi tiết 1 module. Tag [Ch#]/[Phần #] = chapter tương ứng trong Classroom / note điền-chỗ-trống trong Notion.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="1630" height="40" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="1 · Module 1 Analysis" id="m1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="941" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="m1_k54" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1240" height="791" as="geometry"/></mxCell>
<mxCell id="m1_t1" value="&lt;b&gt;Module 1 · ANALYSIS – Sơ đồ hệ thống&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1100" height="34" as="geometry"/></mxCell>
<mxCell id="m1_b2" value="&lt;b&gt;M1 · Analysis&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m1_b3" value="M2 · Design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m1_b4" value="M3 · Development" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m1_b5" value="M4 · Implementation&lt;br&gt;&lt;i&gt;(sắp học)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m1_b6" value="M5 · Evaluation&lt;br&gt;&lt;i&gt;(sắp học)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=7;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="840" y="50" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="m1_e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b2" target="m1_b3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b3" target="m1_b4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b4" target="m1_b5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b5" target="m1_b6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_t11" value="&lt;b&gt;TƯ DUY: L&amp;amp;D là Business Partner&lt;br&gt;[Phần 1-2]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="340" height="36" as="geometry"/></mxCell>
<mxCell id="m1_b12" value="&lt;b&gt;Widening Learning Gap&lt;/b&gt;: kiến thức/kỹ năng thay đổi theo cấp số nhân (process, product, business model) → học 1 lần dùng nhiều năm không còn hợp [Phần 1 · NA01]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="174" width="340" height="78" as="geometry"/></mxCell>
<mxCell id="m1_b13" value="&lt;b&gt;Talent gap → Execution gap&lt;/b&gt; (chuyện academy có media center nhưng 0 video). 2 cách có talent: &lt;b&gt;Buy&lt;/b&gt; (tuyển: nhanh, rủi ro, đắt) hoặc &lt;b&gt;Build&lt;/b&gt; (L&amp;amp;D: rẻ hơn, ít rủi ro) [Phần 2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="340" height="78" as="geometry"/></mxCell>
<mxCell id="m1_b14" value='&lt;b&gt;2 phẩm chất của L&amp;amp;D&lt;/b&gt;: &lt;b&gt;STRATEGIC&lt;/b&gt; (gắn mục tiêu kinh doanh, "must have") + &lt;b&gt;SYSTEMATIC&lt;/b&gt; (quy trình nhanh, tránh lãng phí, luôn đánh giá). Vị trí tệ nhất: bị coi là &lt;b&gt;cost center&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="386" width="340" height="78" as="geometry"/></mxCell>
<mxCell id="m1_b15" value='&lt;b&gt;Right Skills – Right Time – Right People&lt;/b&gt;: tránh bẫy "courses I like"; kỹ năng có "use by date"; không phải ai cũng cần training' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="492" width="340" height="63" as="geometry"/></mxCell>
<mxCell id="m1_b16" value='&lt;b&gt;Performance Orientation&lt;/b&gt; vs Content Orientation: hỏi "tổ chức cần competency gì?" chứ không "nhân viên học thêm gì?". &lt;b&gt;Lag time&lt;/b&gt; → phải &lt;b&gt;anticipate&lt;/b&gt; [Phần 2 · NA02]' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="583" width="340" height="78" as="geometry"/></mxCell>
<mxCell id="m1_b17" value="&lt;b&gt;ARTDO model&lt;/b&gt; (cải tiến ADDIE): Strategic Alignment + Competency-based (xây năng lực không chỉ bằng training)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="689" width="340" height="63" as="geometry"/></mxCell>
<mxCell id="m1_e18" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b12" target="m1_b13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e19" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b13" target="m1_b14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e20" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b14" target="m1_b15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e21" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b15" target="m1_b16"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e22" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b16" target="m1_b17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_t23" value="&lt;b&gt;QUY TRÌNH: 3 Stages of Analysis&lt;br&gt;[Phần 4-5]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="130" width="340" height="36" as="geometry"/></mxCell>
<mxCell id="m1_b24" value='&lt;b&gt;⚠ "Wants" analysis – KHÔNG phải Analysis&lt;/b&gt;: gửi form cho phòng ban chọn khóa / quota 40h/năm / CEO thích khóa nào thì cho cả công ty học' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="174" width="340" height="63" as="geometry"/></mxCell>
<mxCell id="m1_b25" value="&lt;b&gt;① INVESTIGATION (WHAT)&lt;/b&gt;: Gap = Desired result − Actual result, phải định lượng (KPI). Vd: giao trong ngày vs 1.7 ngày; $20 vs $21/unit. Khó nhất: chọn đúng metric và lấy được dữ liệu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="265" width="340" height="78" as="geometry"/></mxCell>
<mxCell id="m1_b26" value='&lt;b&gt;② ROOT CAUSE (WHY)&lt;/b&gt;: câu hỏi đầu tiên: &lt;b&gt;"P problem hay E problem?"&lt;/b&gt; — &lt;b&gt;B = f(P,E)&lt;/b&gt; (Kurt Lewin): hành vi = hàm của Person và Environment' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="371" width="340" height="63" as="geometry"/></mxCell>
<mxCell id="m1_b27" value="&lt;b&gt;Gilbert 6 Boxes (BEM)&lt;/b&gt;&lt;br&gt;E (hàng trên): Resources – Structure/Process – Information&lt;br&gt;P (hàng dưới): Knowledge/Skills – Motives – Capacity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="462" width="340" height="93" as="geometry"/></mxCell>
<mxCell id="m1_b28" value="&lt;b&gt;Mager &amp;amp; Pipe&lt;/b&gt;: Can't do (thiếu skill/knowledge) hay Don't want to (motivation)? Có discrepancy không, nghiêm trọng không, có cách đơn giản hơn không? (case Customer Complaints)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="583" width="340" height="78" as="geometry"/></mxCell>
<mxCell id="m1_b29" value="&lt;b&gt;Rummler Organization Systems Model&lt;/b&gt;: survey audit — Support, Performance specs (KPI), Feedback, Capacity, Skills &amp;amp; Knowledge, Motivation, Incentives &amp;amp; Consequences" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="689" width="340" height="78" as="geometry"/></mxCell>
<mxCell id="m1_b30" value="&lt;b&gt;③ INTERVENTION (HOW)&lt;/b&gt;: chỉ chọn training khi root cause là thiếu skill/knowledge. Bỏ qua WHY → chọn sai intervention. &lt;i&gt;&quot;Training – It's Not Always the Answer&quot;&lt;/i&gt; (Stetar · NA04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="795" width="340" height="78" as="geometry"/></mxCell>
<mxCell id="m1_e31" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b24" target="m1_b25"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e32" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b25" target="m1_b26"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e33" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b26" target="m1_b27"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e34" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b27" target="m1_b28"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e35" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b28" target="m1_b29"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e36" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b29" target="m1_b30"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_t37" value="&lt;b&gt;CÔNG CỤ: Data Collection Methods&lt;br&gt;[Phần 3]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="340" height="36" as="geometry"/></mxCell>
<mxCell id="m1_b38" value="&lt;b&gt;Đo Actual performance&lt;/b&gt;: Desired đã có sẵn (KPI, target, standard) → chọn method, thu thập, phân tích" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="174" width="340" height="63" as="geometry"/></mxCell>
<mxCell id="m1_b39" value="&lt;b&gt;① Table Research&lt;/b&gt; (làm TRƯỚC): dữ liệu thứ cấp có sẵn (báo cáo tháng, KPI scorecard, non-compliance report) → tiết kiệm thời gian/tiền, bảo mật, đáng tin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="265" width="340" height="78" as="geometry"/></mxCell>
<mxCell id="m1_b40" value="&lt;b&gt;② Interview&lt;/b&gt; (Field research): rich data nhất. Bí quyết: tạo &lt;b&gt;rapport/trust&lt;/b&gt; trước, làm homework, chuẩn bị câu hỏi. Cũng là cách xây partnership" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="371" width="340" height="63" as="geometry"/></mxCell>
<mxCell id="m1_b41" value="&lt;b&gt;③ Survey&lt;/b&gt;: Likert (5-7 điểm, chi tiết hơn) · Binary (Yes/No) · Multiple choice · Ranking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="462" width="340" height="48" as="geometry"/></mxCell>
<mxCell id="m1_b42" value="&lt;b&gt;④ Observation&lt;/b&gt;: khi vấn đề ở nhóm nhỏ/cá nhân; dùng observer có chuyên môn (supervisor/expert)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="538" width="340" height="48" as="geometry"/></mxCell>
<mxCell id="m1_b43" value="&lt;b&gt;Job-task analysis&lt;/b&gt; (research hoặc &lt;b&gt;DACUM&lt;/b&gt;): outcomes – duties – tasks – steps → dùng tiếp ở FEA của M2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="614" width="340" height="63" as="geometry"/></mxCell>
<mxCell id="m1_b44" value="&lt;b&gt;OUTPUT: Needs Analysis Report&lt;/b&gt; — ghi lại toàn bộ quá trình từ vấn đề → intervention được chọn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="705" width="340" height="48" as="geometry"/></mxCell>
<mxCell id="m1_e45" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b38" target="m1_b39"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e46" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b39" target="m1_b40"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e47" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b40" target="m1_b41"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e48" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b41" target="m1_b42"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e49" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b42" target="m1_b43"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e50" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m1_b43" target="m1_b44"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e51" value="data" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;dashed=1;strokeColor=#82b366;fontColor=#82b366;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1_b38" target="m1_b25"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e52" value="ghi" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;dashed=1;strokeColor=#6c8ebf;fontColor=#6c8ebf;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1_b30" target="m1_b44"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m1_e53" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;dashed=1;strokeColor=#d79b00;fontColor=#d79b00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1_b16" target="m1_b24"><mxGeometry relative="1" as="geometry"/></mxCell>

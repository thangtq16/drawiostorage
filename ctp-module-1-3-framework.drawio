<mxCell id="m2_e66" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b60" target="m2_b61"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e67" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b61" target="m2_b62"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e68" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;" edge="1" parent="1" source="m2_b62" target="m2_b63"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e69" value="input" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;dashed=1;strokeColor=#d79b00;fontColor=#d79b00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2_b18" target="m2_b28"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m2_e70" value="→ HOW" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;rounded=1;dashed=1;strokeColor=#6c8ebf;fontColor=#6c8ebf;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2_b34" target="m2_b44"><mxGeometry relative="1" as="geometry"/></mxCell>

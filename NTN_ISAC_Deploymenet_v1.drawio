olor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="1394" width="30" height="20" as="geometry"/></mxCell><mxCell id="lt1" value="Nhánh B: điều khiển – oracle là đặc tả/contract" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="1394" width="370" height="20" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="840" y="1394" width="30" height="20" as="geometry"/></mxCell><mxCell id="lt2" value="Sign-off RTL (lint, CDC, STA, PPA 28 nm)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="878" y="1394" width="370" height="20" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="0" y="1424" width="30" height="20" as="geometry"/></mxCell><mxCell id="lt3" value="Verification (UVM, phòng DV)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="38" y="1424" width="370" height="20" as="geometry"/></mxCell><mxCell id="lg4" value="" style="rounded=1;html=1;fillColor=#cce5ff;strokeColor=#36393d;" vertex="1" parent="1"><mxGeometry x="420" y="1424" width="30" height="20" as="geometry"/></mxCell><mxCell id="lt4" value="Validation trên FPGA" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="1424" width="370" height="20" as="geometry"/></mxCell><mxCell id="lg5" value="" style="rounded=1;html=1;fillColor=#ffcd28;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="840" y="1424" width="30" height="20" as="geometry"/></mxCell><mxCell id="lt5" value="Cổng Go / Hold / Recycle / Kill" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="878" y="1424" width="370" height="20" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Ba mức kiểm chứng:&lt;/b&gt; (1) C: ap_fixed so với double, mô hình bit-true so với MATLAB · (2) C/RTL co-sim bit-exact trong Vitis HLS · (3) UVM độc lập của phòng DV. &lt;b&gt;Validation:&lt;/b&gt; chạy trên bo FPGA. &lt;b&gt;Sign-off:&lt;/b&gt; R5–R6 tổng hợp kết quả để ký bàn giao." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1260" y="1390" width="730" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
 style="rounded=0;html=1;fillColor=#fff2cc;opacity=35;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1090" y="1264" width="300" height="82" as="geometry"/></mxCell><mxCell id="CAI4" value="" style="rounded=0;html=1;fillColor=#fff2cc;opacity=35;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1390" y="1264" width="300" height="82" as="geometry"/></mxCell><mxCell id="CAI5" value="" style="rounded=0;html=1;fillColor=#fff2cc;opacity=35;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1690" y="1264" width="300" height="82" as="geometry"/></mxCell><mxCell id="MG1" value="MG1. Thuyết minh, dự toán chi tiết&lt;br&gt;được duyệt trước 28/02/2027 (D3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="205" y="124" width="270" height="46" as="geometry"/></mxCell><mxCell id="MG2" value="MG2. Tuyển 03 HRL13+, ký offer T1–T2 (D1);&lt;br&gt;xác nhận người mượn DV/RTL/FPGA/Nhúng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="205" y="182" width="270" height="46" as="geometry"/></mxCell><mxCell id="MG3" value="MG3. Ký HĐ hợp tác ĐHQG; VHT đồng ý&lt;br&gt;04 kỹ sư ~2,5 MM/người (D2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="205" y="240" width="270" height="46" as="geometry"/></mxCell><mxCell id="G0" value="&lt;b&gt;G0&lt;br&gt;Kick-off&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffcd28;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="294" width="100" height="62" as="geometry"/></mxCell><mxCell id="MG4" value="MG4. Làm việc với VHT → văn bản&lt;br&gt;xác nhận nhu cầu (D4, tiêu chí G1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="124" width="270" height="46" as="geometry"/></mxCell><mxCell id="MG5" value="MG5. Đăng ký Nền: bo FPGA, server AI;&lt;br&gt;kick-off, giao việc theo IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="182" width="270" height="46" as="geometry"/></mxCell><mxCell id="G1" value="&lt;b&gt;G1&lt;br&gt;bit-true&lt;br&gt;+ VHT&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffcd28;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="680" y="236" width="100" height="62" as="geometry"/></mxCell><mxCell id="MG6" value="MG6. Theo dõi R4: nhận RTL PHY&lt;br&gt;VTBR trước T0+4; báo cáo quý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="124" width="270" height="46" as="geometry"/></mxCell><mxCell id="G2" value="&lt;b&gt;G2&lt;br&gt;PHY + ISAC&lt;br&gt;L1 trên bo&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffcd28;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="980" y="178" width="100" height="62" as="geometry"/></mxCell><mxCell id="MG7" value="MG7. Thủ tục thuê máy giả lập kênh&lt;br&gt;vệ tinh (từ 8/2027); nộp sáng chế" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1105" y="124" width="270" height="46" as="geometry"/></mxCell><mxCell id="G3" value="&lt;b&gt;G3&lt;br&gt;NTN 2 bo&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffcd28;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1280" y="178" width="100" height="62" as="geometry"/></mxCell><mxCell id="MG8" value="MG8. Quyết Kill/giữ từng khối&lt;br&gt;cho bản v1.0; bài báo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1405" y="124" width="270" height="46" as="geometry"/></mxCell><mxCell id="G4" value="&lt;b&gt;G4&lt;br&gt;ISAC đủ lớp&lt;br&gt;UVM xong&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffcd28;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1580" y="178" width="100" height="62" as="geometry"/></mxCell><mxCell id="MG9" value="MG9. Nghiệm thu đề tài;&lt;br&gt;biên bản tiếp nhận của VHT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1705" y="124" width="270" height="46" as="geometry"/></mxCell><mxCell id="G5" value="&lt;b&gt;G5&lt;br&gt;Bàn giao&lt;br&gt;v1.0&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffcd28;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1880" y="178" width="100" height="62" as="geometry"/></mxCell><mxCell id="SP1" value="SP1. Đọc 3GPP Rel-17/19, TR 38.765;&lt;br&gt;chốt kịch bản LEO/GEO, UAV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="205" y="380" width="270" height="46" as="geometry"/></mxCell><mxCell id="SP2" value="SP2. Chốt 22 IP; phân loại&lt;br&gt;A (DSP) / B (điều khiển)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="205" y="438" width="270" height="46" as="geometry"/></mxCell><mxCell id="SP3" value="SP3. Kiến trúc hệ thống; chuẩn giao diện:&lt;br&gt;AXI4-Stream, AXI-Lite, regmap, timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="380" width="270" height="46" as="geometry"/></mxCell><mxCell id="SP4" value="SP4. Đặc tả từng IP: yêu cầu có ID,&lt;br&gt;truy về điều khoản 3GPP (RTM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="438" width="270" height="46" as="geometry"/></mxCell><mxCell id="SP5" value="SP5. Ngân sách: MSE/EVM, Pd/Pfa,&lt;br&gt;xung nhịp, latency/slot, tài nguyên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="496" width="270" height="46" as="geometry"/></mxCell><mxCell id="SP6" value="SP6. Quản lý thay đổi đặc tả (ECR);&lt;br&gt;cập nhật RTM sau mỗi cổng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="380" width="270" height="46" as="geometry"/></mxCell><mxCell id="SP7" value="SP7. Phần mềm giao thức: SIB19,&lt;br&gt;quỹ đạo, TA chung, K_offset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1105" y="380" width="270" height="46" as="geometry"/></mxCell><mxCell id="SP8" value="SP8. Phần mềm quản lý mục tiêu,&lt;br&gt;lập lịch đo ISAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1405" y="380" width="270" height="46" as="geometry"/></mxCell><mxCell id="SP9" value="SP9. Tài liệu người dùng IP,&lt;br&gt;datasheet, hướng dẫn tích hợp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1705" y="380" width="270" height="46" as="geometry"/></mxCell><mxCell id="A1" value="A1. MATLAB: mô hình thuật toán (float)&lt;br&gt;+ mô hình hướng phần cứng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="578" width="270" height="46" as="geometry"/></mxCell><mxCell id="A2" value="A2. C++ double = MATLAB; profiling&lt;br&gt;→ ap_fixed, làm tròn, tràn số" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="636" width="270" height="46" as="geometry"/></mxCell><mxCell id="A3" value="A3. Đo SQNR/EVM; mô hình C bit-true&lt;br&gt;+ vector vàng = ORACLE (G1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="694" width="270" height="46" as="geometry"/></mxCell><mxCell id="A4" value="A4. HLS lớp 1 ISAC: U1, U3, U4, U5, U7, U9&lt;br&gt;C-sim, synthesis, đọc II/latency/tài nguyên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="578" width="270" height="46" as="geometry"/></mxCell><mxCell id="A5" value="A5. Tối ưu PIPELINE/UNROLL/PARTITION/&lt;br&gt;DATAFLOW; nhật ký tối ưu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="636" width="270" height="46" as="geometry"/></mxCell><mxCell id="A6" value="A6. C/RTL co-sim bit-exact;&lt;br&gt;bàn giao RTL + báo cáo HLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="694" width="270" height="46" as="geometry"/></mxCell><mxCell id="A7" value="A7. HLS NTN: NT1, NT2, NT4, NT6, NT9&lt;br&gt;(lặp A4 → A6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1105" y="578" width="270" height="46" as="geometry"/></mxCell><mxCell id="A8" value="A8. HLS ISAC lớp 2–5: U6, U8,&lt;br&gt;U10, U11, U12 (lặp A4 → A6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1405" y="578" width="270" height="46" as="geometry"/></mxCell><mxCell id="A9" value="A9. Đóng gói mô hình C bit-true,&lt;br&gt;vector, báo cáo độ chính xác" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1705" y="578" width="270" height="46" as="geometry"/></mxCell><mxCell id="B1" value="B1. Spec → structured spec + RTM;&lt;br&gt;người duyệt yêu cầu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="776" width="270" height="46" as="geometry"/></mxCell><mxCell id="B2" value="B2. Verification contract độc lập RTL&lt;br&gt;(oracle theo đặc tả)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="834" width="270" height="46" as="geometry"/></mxCell><mxCell id="B3" value="B3. Thí điểm AI: U14 (DMA, regmap), U13, NT7&lt;br&gt;sinh RTL SV + lint Verilator + Yosys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="776" width="270" height="46" as="geometry"/></mxCell><mxCell id="B4" value="B4. SVA giao diện + testbench smoke;&lt;br&gt;người duyệt; đo giờ tiết kiệm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="834" width="270" height="46" as="geometry"/></mxCell><mxCell id="B5" value="B5. NT5 HARQ 32 tiến trình,&lt;br&gt;NT8 chuyển chùm/feeder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1105" y="776" width="270" height="46" as="geometry"/></mxCell><mxCell id="B6" value="B6. U15 recorder/ring buffer;&lt;br&gt;khối O-RAN 7.2x, đồng bộ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1405" y="776" width="270" height="46" as="geometry"/></mxCell><mxCell id="R1" value="R1. Review RTL do HLS sinh: wrapper,&lt;br&gt;reset, clock, giao diện chuẩn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="916" width="270" height="46" as="geometry"/></mxCell><mxCell id="R2" value="R2. Lint + CDC từng IP;&lt;br&gt;tích hợp nền PHY VTBR + U14/NT7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="974" width="270" height="46" as="geometry"/></mxCell><mxCell id="R3" value="R3. Tích hợp chuỗi NTN; synthesis&lt;br&gt;&amp; đóng timing FPGA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1105" y="916" width="270" height="46" as="geometry"/></mxCell><mxCell id="R4" value="R4. Tích hợp chuỗi ISAC 5 lớp;&lt;br&gt;lint/CDC toàn chuỗi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1405" y="916" width="270" height="46" as="geometry"/></mxCell><mxCell id="R5" value="R5. Tổng hợp thử 28 nm: SDC, STA&lt;br&gt;sơ bộ, báo cáo diện tích/công suất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1705" y="916" width="270" height="46" as="geometry"/></mxCell><mxCell id="R6" value="R6. Checklist RTL sign-off; đóng gói&lt;br&gt;thư viện v1.0 (RTL + C + vector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1705" y="974" width="270" height="46" as="geometry"/></mxCell><mxCell id="D0" value="D0. vPlan; môi trường UVM chung:&lt;br&gt;AXI agent, cầu DPI-C tới mô hình bit-true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="1056" width="270" height="46" as="geometry"/></mxCell><mxCell id="D1" value="D1. UVM đợt 1: U14, U13, U9, U1,&lt;br&gt;U4, U3, U5, U7; thử RTL PHY VTBR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="1056" width="270" height="46" as="geometry"/></mxCell><mxCell id="D2" value="D2. UVM đợt 2: 8 IP NTN&lt;br&gt;(random theo cấu hình, độ phủ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1105" y="1056" width="270" height="46" as="geometry"/></mxCell><mxCell id="D3" value="D3. UVM đợt 3: U6, U8, U10–U12, U15;&lt;br&gt;báo cáo độ phủ (G4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1405" y="1056" width="270" height="46" as="geometry"/></mxCell><mxCell id="D4" value="D4. Kiểm chuỗi, đóng độ phủ,&lt;br&gt;báo cáo nghiệm thu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1705" y="1056" width="270" height="46" as="geometry"/></mxCell><mxCell id="F1" value="F1. Phần mềm phát lại I/Q; mô hình kênh&lt;br&gt;LEO/GEO, kịch bản mục tiêu (mã nguồn mở)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="1138" width="270" height="46" as="geometry"/></mxCell><mxCell id="F2" value="F2. Vivado block design 1 bo ZCU216&lt;br&gt;(từ 7/2027): PHY + ISAC lớp 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="1138" width="270" height="46" as="geometry"/></mxCell><mxCell id="F3" value="F3. Driver, DMA, phần mềm điều khiển;&lt;br&gt;kiểm trên bo (validation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="1196" width="270" height="46" as="geometry"/></mxCell><mxCell id="F4" value="F4. 2 bo ZCU216: NTN qua kênh vệ tinh&lt;br&gt;mô phỏng (thuê máy giả lập)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1105" y="1138" width="270" height="46" as="geometry"/></mxCell><mxCell id="F5" value="F5. 3 bo: + ZCU102/ADRV9002 phát mục tiêu;&lt;br&gt;đo Pd, Pfa ISAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1405" y="1138" width="270" height="46" as="geometry"/></mxCell><mxCell id="F6" value="F6. Demo hai bo cho VHT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1705" y="1138" width="270" height="46" as="geometry"/></mxCell><mxCell id="X1" value="X1. Hạ tầng AI nội bộ, sandbox&lt;br&gt;(không đưa code/netlist ra ngoài)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="205" y="1278" width="270" height="46" as="geometry"/></mxCell><mxCell id="X2" value="X2. Bộ prompt/skill xCockpit; đo&lt;br&gt;baseline giờ công Matlab/C/RTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="505" y="1278" width="270" height="46" as="geometry"/></mxCell><mxCell id="X3" value="X3. Kho tri thức: nạp sau mỗi cổng;&lt;br&gt;bắt đầu đo % MM giảm (Q2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="805" y="1278" width="270" height="46" as="geometry"/></mxCell><mxCell id="X4" value="X4. HIL regression 24/7 trên 2 bo&lt;br&gt;(báo cáo pass/fail tự sinh)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1105" y="1278" width="270" height="46" as="geometry"/></mxCell><mxCell id="X5" value="X5. Báo cáo KR AI: % MM giảm,&lt;br&gt;bài học cho đề tài kế tiếp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1705" y="1278" width="270
<mxfile host="app.diagrams.net"><diagram id="ntnisac" name="Trien khai NTN-ISAC"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Đề tài NTN/ISAC – Các bước triển khai chi tiết (Algorithm-to-RTL)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Thư viện 22 IP RTL cho trạm gốc 5G-Advanced hướng 6G · T0 = 3/2027 · Phòng SIGMA, VSI&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1990" height="60" as="geometry"/></mxCell><mxCell id="hP0" value="&lt;b&gt;P0. Chuẩn bị (trước G0)&lt;/b&gt;&lt;br&gt;11/2026 – 2/2027" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="60" width="300" height="50" as="geometry"/></mxCell><mxCell id="hP1" value="&lt;b&gt;P1. Đặc tả &amp; bit-true (T1–T3)&lt;/b&gt;&lt;br&gt;3 – 5/2027  →  G1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="60" width="300" height="50" as="geometry"/></mxCell><mxCell id="hP2" value="&lt;b&gt;P2. HLS/RTL lớp nền + ISAC lớp 1 (T4–T7)&lt;/b&gt;&lt;br&gt;6 – 9/2027  →  G2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="60" width="300" height="50" as="geometry"/></mxCell><mxCell id="hP3" value="&lt;b&gt;P3. Nhánh NTN (T8–T9)&lt;/b&gt;&lt;br&gt;10 – 11/2027  →  G3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="60" width="300" height="50" as="geometry"/></mxCell><mxCell id="hP4" val